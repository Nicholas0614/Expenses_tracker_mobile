<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pocket_bg">

    <ScrollView android:id="@+id/scrollHome" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:scrollbars="none" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/bottomNav" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

            <!-- Header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="22dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:id="@+id/tvDateHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MONDAY, 2 NOVEMBER" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/pocket_grey" android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Karina"
                        android:textColor="@color/pocket_navy"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Balance card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_balance" android:padding="22dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TOTAL WALLET BALANCE" android:textSize="12sp" android:letterSpacing="0.08" android:textColor="#B8CCF0" android:fontFamily="@font/poppins_regular"/>

                <TextView android:id="@+id/tvTotalBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="RM 0.00" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFFFFF" android:fontFamily="@font/poppins_regular"/>

                <TextView android:id="@+id/tvUnassigned" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Some transactions are unassigned" android:textSize="11sp" android:textColor="#FFE3A7" android:visibility="gone" android:fontFamily="@font/poppins_regular"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:layout_marginBottom="16dp" android:background="#405873"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monthly Income" android:textSize="12sp" android:textColor="#B8CCF0" android:fontFamily="@font/poppins_regular"/>

                        <TextView android:id="@+id/tvMonthlyIncome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="RM 0.00" android:textSize="17sp" android:textStyle="bold" android:textColor="#83E0BF" android:fontFamily="@font/poppins_regular"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monthly Expenses" android:textSize="12sp" android:textColor="#B8CCF0" android:fontFamily="@font/poppins_regular"/>

                        <TextView android:id="@+id/tvMonthlyExpense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="RM 0.00" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFB3B3" android:fontFamily="@font/poppins_regular"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Quick actions -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp" android:baselineAligned="false">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnWallets" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:text="Wallets" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/pocket_navy" android:backgroundTint="#E4F4F3" app:cornerRadius="16dp" android:fontFamily="@font/poppins_regular"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/btnBudgets" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:text="Budgets" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/pocket_navy" android:backgroundTint="#E4F4F3" app:cornerRadius="16dp" android:fontFamily="@font/poppins_regular"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/btnBackup" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="5dp" android:text="Backup" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/pocket_navy" android:backgroundTint="#E4F4F3" app:cornerRadius="16dp" android:fontFamily="@font/poppins_regular"/>
            </LinearLayout>

            <!-- Budget section -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:background="@drawable/bg_white_card" android:padding="18dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Monthly Budget" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/pocket_navy" android:fontFamily="@font/poppins_regular"/>

                    <TextView android:id="@+id/btnViewBudgets" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View all" android:textSize="13sp" android:padding="6dp" android:textColor="@color/pocket_teal" android:fontFamily="@font/poppins_regular"/>
                </LinearLayout>

                <TextView android:id="@+id/tvBudgetSpent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="RM 0.00 spent" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/pocket_navy" android:fontFamily="@font/poppins_regular"/>

                <TextView android:id="@+id/tvBudgetLimit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="of RM 0.00 budget" android:textSize="13sp" android:textColor="@color/pocket_grey" android:fontFamily="@font/poppins_regular"/>

                <ProgressBar android:id="@+id/progressBudget" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="9dp" android:layout_marginTop="16dp" android:max="1000" android:progress="0" android:progressTint="@color/pocket_teal" android:progressBackgroundTint="@color/pocket_border"/>

                <TextView android:id="@+id/tvBudgetStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Set your first budget" android:textSize="13sp" android:textColor="@color/pocket_grey" android:fontFamily="@font/poppins_regular"/>
            </LinearLayout>

            <!-- Recent activity -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" android:orientation="horizontal" android:gravity="center_vertical">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recent Activity" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pocket_navy" android:fontFamily="@font/poppins_regular"/>

                <TextView android:id="@+id/btnSeeAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all" android:padding="6dp" android:textSize="13sp" android:textColor="@color/pocket_teal" android:fontFamily="@font/poppins_regular"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/recentContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_white_card" android:padding="12dp"/>

            <TextView android:id="@+id/tvMonthNet" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="18dp" android:text="Monthly net: RM 0.00" android:textSize="12sp" android:gravity="center" android:textColor="@color/pocket_grey" android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>
    </ScrollView>



    <com.google.android.material.button.MaterialButton android:id="@+id/btnAddExpense" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginEnd="18dp" android:layout_marginBottom="16dp" android:text="Add Expense" android:textSize="14sp" android:textAllCaps="false" android:textColor="#FFFFFF" android:elevation="8dp" android:backgroundTint="@color/pocket_teal" app:cornerRadius="18dp" app:layout_constraintBottom_toTopOf="@id/bottomNav" app:layout_constraintEnd_toEndOf="parent" android:fontFamily="@font/poppins_regular"/>



    <!-- Bottom navigation -->
    <LinearLayout android:id="@+id/bottomNav" android:layout_width="0dp" android:layout_height="68dp" android:orientation="horizontal" android:gravity="center" android:background="#FFFFFF" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⌂&#10;Home" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/pocket_teal" android:fontFamily="@font/poppins_regular"/>

        <TextView android:id="@+id/navActivity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="☷&#10;Activity" android:gravity="center" android:textSize="13sp" android:textColor="@color/pocket_grey" android:fontFamily="@font/poppins_regular"/>

        <TextView android:id="@+id/navReports" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▥&#10;Reports" android:gravity="center" android:textSize="13sp" android:textColor="@color/pocket_grey" android:fontFamily="@font/poppins_regular"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
